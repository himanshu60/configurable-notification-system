# ---------------------------------------------------------------------------
# Copy to .env before running the API:  cp .env.example .env
# Every variable here is validated on boot (apps/api/src/config/env.ts).
# The process exits immediately if something is missing or malformed.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/cns

# Auth
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10

# CORS: comma separated list of allowed origins
CORS_ORIGINS=http://localhost:4200

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ---------------------------------------------------------------------------
# Delivery worker
# ---------------------------------------------------------------------------
# Set WORKER_ENABLED=false to run the API without an in-process dispatcher,
# e.g. when running the worker as a separate process.
# Serve the built Angular client from the API process (single-service deploy).
# Leave false for local development, where the Angular dev server runs on 4200.
SERVE_WEB=false

WORKER_ENABLED=true
WORKER_ID=api-1
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=10
WORKER_VISIBILITY_TIMEOUT_MS=30000
DELIVERY_MAX_ATTEMPTS=4
DELIVERY_BACKOFF_BASE_MS=2000
DELIVERY_BACKOFF_MAX_MS=300000

# ---------------------------------------------------------------------------
# Mock email provider
# ---------------------------------------------------------------------------
# MOCK_EMAIL_FAILURE_RATE is 0..1. Raise it to 1 to demo retries and the
# dead-letter path end to end.
MOCK_EMAIL_FAILURE_RATE=0
MOCK_EMAIL_MIN_LATENCY_MS=50
MOCK_EMAIL_MAX_LATENCY_MS=250
